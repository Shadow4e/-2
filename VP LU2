n = int(input('Enter the first number: '))
m = int(input('Enter the second number: '))

op = input('Enter the operation you want to do (+, -, *, /): ')

if op == "+":
    print("The result is:", n + m)

elif op == "-":
    print("The result is:", n - m)

elif op == "*":
    print("The result is:", n * m)

elif op == "/":
    if m != 0:
        print("The result is:", n / m)
    else:
        print("Can't divide by 0")

else:
    print("Invalid operation")
