sentence = input("Enter a sentence: ")

char_count = {}

for char in sentence:
    if char != " ":
        if char not in char_count:
            char_count[char] = 1
        else:
            char_count[char] += 1

if char_count:
    max_count = max(char_count.values())
    most_common = []

    for key, value in char_count.items():
        if value == max_count:
            most_common.append(key)

    if len(most_common) == 1:
        print(f"Най-често срещаният символ е '{most_common[0]}' с {max_count} срещания.")
    else:
        formatted_chars = []

        for c in most_common:
            formatted_chars.append(f"'{c}'")
        chars_str = ", ".join(formatted_chars)
        print(f"Най-често срещаните символи са {chars_str}, всеки с по {max_count} срещания.")
else:
    print("No valid characters entered.")

