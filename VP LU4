words = input("Enter words separated by space: ").split()
k = int(input("Enter minimum length: "))

filtered_list = []

for word in words:
    if len(word) >= k:
        filtered_list.append(word)

filtered_words = tuple(filtered_list)

print("Филтрирани думи в кортеж:", filtered_words)
