number = int(input("Въведи цяло число: "))

nums = []

for i in range(1, number + 1):
    nums.append(i)

dictionary = {}

for i in range(len(nums)):
    dictionary[nums[i]] = nums[-i - 1]

print("Списък:", nums)
print("Речник:", dictionary)
