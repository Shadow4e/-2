import random

nums = []

for i in range(5):
    nums.append(random.randint(1,10))
print(f"This are the nums: {nums}")

new_list = []

for i in range(len(nums)):
    new_list.append(nums[i])

    if i < len(nums)-1:
     new_list.append(nums[i] + nums[i+1])
print(new_list)
